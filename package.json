{
  "name": "geo-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "run:once": "tsx --tsconfig tsconfig.scripts.json scripts/run-once.ts",
    "run:full": "tsx --tsconfig tsconfig.scripts.json scripts/run-full.ts",
    "stats": "tsx --tsconfig tsconfig.scripts.json scripts/stats.ts",
    "inspect": "tsx --tsconfig tsconfig.scripts.json scripts/inspect.ts",
    "engine:set": "tsx --tsconfig tsconfig.scripts.json scripts/engine-set.ts",
    "vercel-build": "drizzle-kit migrate && next build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/perplexity": "^4.0.39",
    "@base-ui/react": "^1.8.0",
    "@electric-sql/pglite": "^0.5.8",
    "ai": "^7.0.93",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "robots-parser": "^3.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.8.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
